NEXT_PUBLIC_API_URL=http://localhost:4000
# Only needed when the server can't reach the API the same way the browser
# does — e.g. in a GitHub Codespace, where NEXT_PUBLIC_API_URL has to be a
# forwarded public URL for the browser, but the Next.js server (same
# container as the API) should hit it directly instead of bouncing through
# that public URL's auth gate. Leave unset here; it falls back to
# NEXT_PUBLIC_API_URL. Server-side only — no NEXT_PUBLIC_ prefix, never sent
# to the browser.
# INTERNAL_API_URL=http://localhost:4000
NEXT_PUBLIC_MAP_TILES_URL=https://tiles.openfreemap.org/styles/liberty
# Used as the base URL for link-preview metadata (og:image etc.) — must be
# the real public domain in production so WhatsApp/Facebook can fetch it.
NEXT_PUBLIC_SITE_URL=https://durgapandal.com

# Must match the API's REQUIRE_CONTRIBUTOR_VERIFICATION — when "true", Add
# Pandal shows the send-code/verify-code OTP step; when "false" (or unset),
# contributors submit directly on contact info alone.
NEXT_PUBLIC_REQUIRE_CONTRIBUTOR_VERIFICATION=false
